{
  "name": "Rocketseat Financy",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-24-bookworm",
  "remoteUser": "node",
  "containerEnv": {
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
  },
  "postCreateCommand": "sudo corepack enable && corepack prepare pnpm@10.33.0 --activate && pnpm install --frozen-lockfile",
  "forwardPorts": [4000, 5173, 6006],
  "portsAttributes": {
    "4000": {
      "label": "Backend"
    },
    "5173": {
      "label": "Frontend"
    },
    "6006": {
      "label": "Storybook"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["biomejs.biome", "Prisma.prisma", "ms-playwright.playwright"]
    }
  }
}
